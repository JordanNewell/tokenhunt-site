---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/jetbrains-mono/800.css';

const hooks = [
  { hook: 'UserPromptSubmit', sees: 'your paste', action: 'WARN', level: 'warn' },
  { hook: 'PreToolUse:Bash', sees: 'command about to run', action: 'BLOCK', level: 'block' },
  { hook: 'PostToolUse:Bash', sees: 'command output', action: 'WARN + log', level: 'warn' },
  { hook: 'PostToolUse:Read', sees: 'file contents', action: 'WARN + log', level: 'warn' },
  { hook: 'PreToolUse:Edit/Write', sees: 'new file content', action: 'BLOCK', level: 'block' },
  { hook: 'PostToolUse:Edit/Write', sees: 'echo', action: 'WARN + log', level: 'warn' },
];

const providers = [
  // dev/infra
  'Z.ai', 'Anthropic', 'OpenAI', 'GitHub', 'GitLab', 'Figma', 'PyPI', 'npm', 'Linear', 'Stripe', 'Slack',
  // llm inference — dedicated rules
  'OpenRouter', 'Groq', 'Together AI', 'Fireworks', 'Mistral', 'xAI', 'Perplexity', 'Hugging Face',
  'Cerebras', 'Replicate', 'Vercel AI Gateway', 'NVIDIA NIM', 'Chutes', 'Requesty', 'Novita', 'Upstage',
  'Baseten', 'Baidu Qianfan', 'fal.ai', 'DashScope', 'Moonshot Kimi', 'Cohere', 'Scaleway',
  'SambaNova', 'Nebius', 'AI21', 'OVHcloud', 'FriendliAI', 'GMI Cloud', 'Crusoe', 'Featherless',
  'DeepInfra', 'Inference.net', 'BytePlus',
  // caught via generic fallback shapes
  'DeepSeek', 'StepFun', 'SiliconFlow', 'Poe', 'Qwen', 'MiniMax',
];

const tiers = [
  {
    n: '01',
    name: 'token-hunt',
    tag: 'free · BUSL-1.1',
    desc: 'The engine. CLI (scan / list / close / watch), six hooks with block-and-rotate behavior, the allowlist, and the bash escape-hatch runtime detector no regex can see.',
    cta: 'github.com/JordanNewell/token-hunt',
    href: 'https://github.com/JordanNewell/token-hunt',
  },
  {
    n: '02',
    name: 'pat-scanner',
    tag: 'free · BUSL-1.1',
    desc: 'The one-command plugin. One hook, 13 credential classes, regex matching. Install it and you\'re covered. The guard, without the workflow.',
    cta: 'github.com/JordanNewell/pat-scanner',
    href: 'https://github.com/JordanNewell/pat-scanner',
  },
  {
    n: '03',
    name: 'token-hunt-pro',
    tag: 'commercial',
    desc: 'Silent redaction — the agent never sees the raw value. Active verification — checks whether a found key is actually live against GitHub, Stripe, and Slack. Offline ed25519 licensing. Zero phone-home.',
    cta: 'join the waitlist — info@tokenhunt.dev',
    href: 'mailto:info@tokenhunt.dev?subject=token-hunt-pro%20waitlist',
  },
];
import Seo from "../components/Seo.astro";

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "token-hunt",
  "alternateName": "TokenHunt",
  "applicationCategory": "SecurityApplication",
  "operatingSystem": "Linux, macOS, Windows",
  "description": "Hook-based secret scanner for AI coding agents. token-hunt catches leaks when you paste, when your agent reads, and when its tools return — not at commit time. 48 credential rules across 53 provider families, fail-closed BLOCK hooks, zero cloud, zero telemetry.",
  "url": "https://tokenhunt.dev/",
  "downloadUrl": "https://pypi.org/project/token-hunt/",
  "installUrl": "https://tokenhunt.dev/docs",
  "codeRepository": "https://github.com/JordanNewell/token-hunt",
  "softwareVersion": "0.1.0",
  "datePublished": "2026-10-15",
  "license": "https://tokenhunt.dev/license",
  "isAccessibleForFree": true,
  "author": { "@type": "Person", "name": "Jordan Newell", "url": "https://jordannewell.com" },
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "keywords": "secret scanning, secrets detection, AI coding agents, Claude Code, credential leak, API key rotation, developer security, hooks, pre-tool-use, gitleaks alternative",
  "featureList": [
    "Six hooks covering every entry point for secrets into an agent transcript",
    "BLOCK hooks stop the tool call before it runs (PreToolUse:Bash, PreToolUse:Edit/Write)",
    "WARN hooks catch pastes, command output, file reads, and write echoes",
    "48 credential rules across 53 provider families",
    "CLI: token-hunt scan / list / close / watch",
    "Findings include rule, line, and a rotate URL",
    "Allowlist for test fixtures and known-safe strings",
    "Zero cloud, zero telemetry — everything runs locally"
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is TokenHunt?",
      "acceptedAnswer": { "@type": "Answer", "text": "TokenHunt (pip: token-hunt) is a hook-based secret scanner for AI coding agents such as Claude Code. It inspects what you paste, what commands run, what files your agent reads and writes, and blocks tool calls that would leak credentials — 48 rules across 53 provider families." }
    },
    {
      "@type": "Question",
      "name": "How is token-hunt different from gitleaks or truffleHog?",
      "acceptedAnswer": { "@type": "Answer", "text": "Commit-time scanners see the leak after it is already in your transcript or repo. token-hunt runs as agent hooks at chat time — it stops the secret before the tool call executes, fail-closed, and points you at a rotation URL for anything that slipped through." }
    },
    {
      "@type": "Question",
      "name": "Does token-hunt work with Claude Code?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes — installing the plugin wires all six hooks (UserPromptSubmit, PreToolUse:Bash, PostToolUse:Bash, PostToolUse:Read, PreToolUse:Edit/Write, PostToolUse:Edit/Write) into Claude Code in one step." }
    },
    {
      "@type": "Question",
      "name": "Does token-hunt send my code to the cloud?",
      "acceptedAnswer": { "@type": "Answer", "text": "No. Scanning runs entirely on your machine — zero cloud, zero telemetry." }
    },
    {
      "@type": "Question",
      "name": "How much does token-hunt cost?",
      "acceptedAnswer": { "@type": "Answer", "text": "Free for personal and noncommercial use under BUSL-1.1 (MIT from 2030). Commercial use is by written agreement — see the license page." }
    }
  ]
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "TokenHunt",
  "url": "https://tokenhunt.dev/",
  "logo": "https://tokenhunt.dev/favicon.svg",
  "founder": { "@type": "Person", "name": "Jordan Newell", "url": "https://jordannewell.com" },
  "sameAs": [
    "https://x.com/tokenhuntdev",
    "https://github.com/JordanNewell/token-hunt"
  ]
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TokenHunt — catch secrets at chat time, not commit time</title>
    <meta name="description" content="Hook-based secret scanner for AI coding agents. token-hunt catches leaks when you paste, when your agent reads, and when its tools return — not at commit time." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo
      title="TokenHunt — catch secrets at chat time, not commit time"
      description="Hook-based secret scanner for AI coding agents. Six hooks, fail-closed, 48 rules across 53 provider families. Zero cloud, zero telemetry. pip install token-hunt."
      url="https://tokenhunt.dev/"
      jsonLd={[appSchema, faqSchema, orgSchema]}
    />
    <script is:inline>
      try { if (localStorage.getItem('th-theme') === 'light') document.documentElement.classList.add('light'); } catch {}
    </script>
  </head>
  <body>
    <div class="frame" aria-hidden="true"><i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i></div>
    <div class="site-nav reveal">
      <a class="site-mark" href="/">
        <svg viewBox="0 0 48 48" role="img" aria-label="tokenhunt mark">
          <circle cx="24" cy="24" r="17" fill="none" stroke="currentColor" stroke-width="3.5" />
          <line x1="24" y1="1" x2="24" y2="12" stroke="currentColor" stroke-width="3.5" />
          <line x1="24" y1="36" x2="24" y2="47" stroke="currentColor" stroke-width="3.5" />
          <line x1="1" y1="24" x2="12" y2="24" stroke="currentColor" stroke-width="3.5" />
          <line x1="36" y1="24" x2="47" y2="24" stroke="currentColor" stroke-width="3.5" />
          <circle cx="24" cy="24" r="4.5" fill="currentColor" />
        </svg>
      </a>
      <nav class="corner-nav" aria-label="site">
        <a class="bubble" href="/docs">docs</a>
        <a class="bubble" href="/changelog">changelog</a>
        <div class="socials">
          <a class="circ" href="https://x.com/tokenhuntdev" aria-label="TokenHunt on X" title="@tokenhuntdev">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
          <a class="circ" href="/license" aria-label="license — © 2026 Jordan Newell" title="© 2026 Jordan Newell — license">©</a>
          <a class="circ" href="mailto:info@tokenhunt.dev" aria-label="email info@tokenhunt.dev" title="info@tokenhunt.dev">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-10 6L2 7" />
            </svg>
          </a>
        </div>
      </nav>
    </div>
    <button class="theme-toggle" type="button" aria-label="toggle day/night theme">
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="5" />
        <line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" />
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
        <line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" />
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
      </svg>
    </button>
    <!-- ============ hero ============ -->
    <header class="hero container">
      <h1 class="reveal wordmark">
        t<span class="sr-only">o</span><svg class="reticle" viewBox="0 0 48 48" role="presentation" aria-hidden="true">
          <circle cx="24" cy="24" r="17" fill="none" stroke="currentColor" stroke-width="3.5" />
          <line x1="24" y1="1"  x2="24" y2="12" stroke="currentColor" stroke-width="3.5" />
          <line x1="24" y1="36" x2="24" y2="47" stroke="currentColor" stroke-width="3.5" />
          <line x1="1"  y1="24" x2="12" y2="24" stroke="currentColor" stroke-width="3.5" />
          <line x1="36" y1="24" x2="47" y2="24" stroke="currentColor" stroke-width="3.5" />
          <circle cx="24" cy="24" r="4.5" fill="currentColor" />
        </svg>kenhunt
      </h1>
      <p class="tagline reveal">Catch secrets at <em>chat time</em>, not commit time.</p>
      <p class="kicker reveal">secret scanning for the agentic era</p>
      <p class="lede reveal">
        By the time you run <code>git commit</code>, your key has been sitting in the agent
        transcript for 30 minutes — indexed, synced, maybe re-emitted by a later tool call.
        token-hunt fires while it's happening.
      </p>
      <div class="install reveal" role="group" aria-label="install commands">
        <div class="install-row">
          <span class="prompt">$</span><code>pip install token-hunt</code>
          <span class="hint"># v0.1.0 · zero cloud · fail-closed</span>
        </div>
        <div class="install-row">
          <span class="prompt">$</span><code>claude plugin install token-hunt@JordanNewell</code>
          <span class="hint"># the six-hook guard</span>
        </div>
      </div>
    </header>

    <main>
      <!-- ============ why ============ -->
      <section class="why container">
        <div class="col-head">
          <h2>Scanners watch git.<br />Your keys live in chat.</h2>
          <p>
            gitleaks and trufflehog scan history. The transcript is the new leak surface —
            pastes, file reads, tool output. token-hunt hooks the agent runtime itself,
            at all six points a secret can enter.
          </p>
        </div>
        <div class="col-demo">
          <img
            class="demo-gif"
            src="/demo.gif"
            alt="token-hunt watch catching an Anthropic API key leak in real time, then scan reporting the finding with a rotate URL"
            width="1000"
            height="560"
            loading="lazy"
          />
        </div>
      </section>

      <!-- ============ hooks ============ -->
      <section class="hooks container">
        <h2><span class="sec-num">01</span> Six hooks. Every entry point.</h2>
        <table>
          <thead>
            <tr><th>hook</th><th>what it sees</th><th>action on leak</th></tr>
          </thead>
          <tbody>
            {hooks.map((h) => (
              <tr>
                <td><code>{h.hook}</code></td>
                <td class="dim">{h.sees}</td>
                <td><span class={`sev sev-${h.level}`}>{h.action}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <!-- ============ escape hatch ============ -->
      <section class="escape container">
        <h2><span class="sec-num">02</span> Catches what regex can't.</h2>
        <p class="escape-lede">
          Bash evaluates secrets into emitted text with no literal in sight. token-hunt
          runs a runtime detector for the escape-hatch class — no other scanner sees it.
        </p>
        <div class="escape-grid">
          <div class="escape-col">
            <p class="escape-tag blocked">BLOCKED</p>
            <pre><code>echo ${'{'}ANTHROPIC_API_KEY:+SET{'}'}<br />${'{'}ANTHROPIC_API_KEY:-UNSET{'}'}</code></pre>
            <p class="escape-why">both branches run — the value leaks</p>
          </div>
          <div class="escape-col">
            <p class="escape-tag blocked">BLOCKED</p>
            <pre><code>echo $GITHUB_TOKEN</code></pre>
            <p class="escape-why">direct echo of a secret var</p>
          </div>
          <div class="escape-col ok">
            <p class="escape-tag allowed">ALLOWED</p>
            <pre><code>[ -n "$ANTHROPIC_API_KEY" ] \<br />  && echo SET</code></pre>
            <p class="escape-why">status check — no value emitted</p>
          </div>
        </div>
      </section>

      <!-- ============ tiers ============ -->
      <section class="tiers container">
        <h2><span class="sec-num">03</span> Three shapes. One hunt.</h2>
        {tiers.map((t) => (
          <a class="tier" href={t.href}>
            <span class="tier-n">{t.n}</span>
            <span class="tier-body">
              <span class="tier-name">{t.name}</span>
              <span class="tier-tag">{t.tag}</span>
              <span class="tier-desc">{t.desc}</span>
            </span>
            <span class="tier-cta">→</span>
          </a>
        ))}
      </section>

      <!-- ============ providers ============ -->
      <section class="providers container">
        <p class="providers-label">48 rules · {providers.length} providers built in</p>
        <ul>
          {[...providers].sort((a, b) => a.localeCompare(b)).map((p) => <li>{p}</li>)}
        </ul>
      </section>
    </main>

    <!-- ============ footer ============ -->
    <footer class="footer container">
      <div class="foot-mark" aria-hidden="true">
        <svg viewBox="0 0 48 48" class="reticle-sm">
          <circle cx="24" cy="24" r="17" fill="none" stroke="currentColor" stroke-width="3.5" />
          <line x1="24" y1="1" x2="24" y2="12" stroke="currentColor" stroke-width="3.5" />
          <line x1="24" y1="36" x2="24" y2="47" stroke="currentColor" stroke-width="3.5" />
          <line x1="1" y1="24" x2="12" y2="24" stroke="currentColor" stroke-width="3.5" />
          <line x1="36" y1="24" x2="47" y2="24" stroke="currentColor" stroke-width="3.5" />
          <circle cx="24" cy="24" r="4.5" fill="currentColor" />
        </svg>
      </div>
      <p class="foot-line">tokenhunt.dev — local-first secret scanning. the transcript is the leak surface.</p>
      <a href="https://jordannewell.com" rel="noopener"><img src="/n-logo.png" alt="N" class="foot-n" loading="lazy" /></a>
    </footer>

    <style>
      :root {
        --bg: #0C0D10;
        --surface: #121317;
        --border: #1F2126;
        --text: #F4F3EF;
        --muted: #8A8F98;
        --accent: #FF5A1F;
        --alert: #E5484D;
      }
      :root.light {
        --bg: #F7F6F2;
        --surface: #FFFFFF;
        --border: #E3E1DB;
        --text: #15171C;
        --muted: #686D76;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 1rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
      }
      ::selection { background: var(--accent); color: var(--bg); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      ::-webkit-scrollbar { width: 10px; }
      ::-webkit-scrollbar-track { background: var(--bg); }
      ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 5px; }
      ::-webkit-scrollbar-thumb:hover { background: var(--muted); }

      .container {
        max-width: 68rem;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 4vw, 2rem);
      }
      h2 {
        font-size: clamp(1.4rem, 3vw, 1.9rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.25;
        text-wrap: balance;
        margin-bottom: 2rem;
      }
      .sec-num {
        color: var(--accent);
        font-weight: 500;
        font-size: 0.8em;
        margin-right: 0.75rem;
      }
      code {
        font-family: inherit;
        font-size: 0.92em;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.1em 0.35em;
      }
      a { color: inherit; }

      /* ---- hero ---- */
      .hero { padding-block: clamp(5rem, 12vh, 7rem) clamp(5rem, 12vh, 8rem); position: relative; }

      .site-nav {
        position: absolute;
        top: 40px;
        right: clamp(1.5rem, 3.2vw, 3.5rem);
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .site-mark { display: block; text-decoration: none; }
      .site-mark svg { width: 76px; height: 76px; color: var(--accent); display: block; }

      /* ---- corner nav: stacked symmetrically under the logo ---- */
      .corner-nav {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.55rem;
        margin-top: 1.4rem;
      }

      /* ---- frame: corner brackets hugging the viewport ---- */
      .frame {
        position: fixed;
        inset: 1rem clamp(0.75rem, 1.5vw, 1.25rem) 1.5rem;
        pointer-events: none;
        z-index: 5;
      }
      .frame i { position: absolute; width: 22px; height: 22px; border: 0 solid var(--accent); }
      .frame .tl { top: 0; left: 0; border-top-width: 2px; border-left-width: 2px; }
      .frame .tr { top: 0; right: 0; border-top-width: 2px; border-right-width: 2px; }
      .frame .bl { bottom: 0; left: 0; border-bottom-width: 2px; border-left-width: 2px; }
      .frame .br { bottom: 0; right: 0; border-bottom-width: 2px; border-right-width: 2px; }
      @media (max-width: 640px) {
        .frame { inset: 1rem 1rem 1rem; }
        .frame i { width: 16px; height: 16px; }
      }

      /* ---- theme toggle ---- */
      .theme-toggle {
        position: absolute;
        top: 40px;
        left: clamp(1.5rem, 3.2vw, 3.5rem);
        z-index: 10;
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        background: none;
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--muted);
        cursor: pointer;
      }
      .theme-toggle:hover { color: var(--accent); border-color: var(--accent); }
      .theme-toggle svg { width: 20px; height: 20px; }
      .theme-toggle .sun { display: none; }
      :root.light .theme-toggle .moon { display: none; }
      :root.light .theme-toggle .sun { display: block; }
      @media (max-width: 640px) {
        .site-nav { top: 1.5rem; }
        .site-mark svg { width: 48px; height: 48px; }
        .corner-nav { margin-top: 1rem; }
        .theme-toggle { top: 1.5rem; }
        .foot-n { height: 24px; }
      }

      .kicker {
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.8rem;
        font-weight: 500;
        margin-top: 1.5rem;
        max-width: 30ch;
      }
      .wordmark {
        font-size: clamp(3rem, 9vw, 6rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1;
        margin-left: -0.05em;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      .reticle {
        display: inline-block;
        width: 1ch;
        height: 1ch;
        color: var(--accent);
        margin: 0 0.02em;
        vertical-align: -0.06em;
      }
      .tagline {
        font-size: clamp(1.3rem, 3vw, 1.75rem);
        font-weight: 500;
        letter-spacing: -0.02em;
        margin-top: 1.75rem;
        max-width: 34ch;
      }
      .tagline em { font-style: normal; color: var(--accent); }
      .lede { color: var(--muted); max-width: 52ch; margin-top: 1.25rem; }
      .install {
        display: inline-flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 2.5rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 3px solid var(--accent);
        border-radius: 4px;
        padding: 1rem 1.25rem;
      }
      .install-row { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }
      .install .prompt { color: var(--accent); user-select: none; }
      .install code { background: none; border: none; padding: 0; font-weight: 700; font-size: 1rem; }
      .install .hint { color: var(--muted); font-size: 0.8rem; }

      /* ---- why ---- */
      .why {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: clamp(2rem, 6vw, 4.5rem);
        padding-block: clamp(4rem, 10vh, 7rem);
        border-top: 1px solid var(--border);
        align-items: center;
      }
      .col-head p { color: var(--muted); margin-top: 1.25rem; max-width: 40ch; }
      .demo-gif {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--border);
        border-radius: 8px;
      }
      .term {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
      }
      .term-bar {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.6rem 0.9rem;
        border-bottom: 1px solid var(--border);
      }
      .dot { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--border); }
      .term-title { color: var(--muted); font-size: 0.75rem; margin-left: 0.5rem; }
      .term pre {
        padding: 1.25rem 1.5rem;
        font-size: 0.85rem;
        line-height: 1.7;
        overflow-x: auto;
      }
      .t-dim { color: var(--muted); }
      .t-accent { color: var(--accent); font-weight: 700; }
      .t-red { color: var(--alert); font-weight: 700; }

      /* ---- hooks ---- */
      .hooks { padding-block: clamp(4rem, 10vh, 7rem); border-top: 1px solid var(--border); }
      .hooks table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
      .hooks th {
        text-align: left;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 0.7rem;
        font-weight: 500;
        padding: 0.75rem 1rem 0.75rem 0;
        border-bottom: 1px solid var(--border);
      }
      .hooks td { padding: 0.9rem 1rem 0.9rem 0; border-bottom: 1px solid var(--border); vertical-align: baseline; }
      .hooks td code { background: none; border: none; padding: 0; }
      .dim { color: var(--muted); }
      .sev {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        padding: 0.2rem 0.55rem;
        border-radius: 4px;
        white-space: nowrap;
      }
      .sev-block { background: var(--alert); color: var(--bg); }
      .sev-warn { background: none; color: var(--accent); border: 1px solid var(--accent); }

      /* ---- escape ---- */
      .escape { padding-block: clamp(4rem, 10vh, 7rem); border-top: 1px solid var(--border); }
      .escape-lede { color: var(--muted); max-width: 56ch; margin: -1rem 0 2.5rem; }
      .escape-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.25rem;
      }
      .escape-col pre {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 1.1rem 1.1rem;
        font-size: 0.78rem;
        line-height: 1.7;
        overflow-x: auto;
        min-height: 5.2rem;
      }
      .escape-col.ok pre { border-left: 3px solid var(--accent); }
      .escape-tag { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; margin-bottom: 0.5rem; }
      .escape-tag.blocked { color: var(--alert); }
      .escape-tag.allowed { color: var(--accent); }
      .escape-why { color: var(--muted); font-size: 0.78rem; margin-top: 0.6rem; }

      /* ---- tiers ---- */
      .tiers { padding-block: clamp(4rem, 10vh, 7rem); border-top: 1px solid var(--border); }
      .tier {
        display: grid;
        grid-template-columns: 4rem minmax(0, 1fr) 3rem;
        gap: 1.5rem;
        align-items: start;
        padding-block: 2rem;
        border-bottom: 1px solid var(--border);
        text-decoration: none;
        transition: background 150ms ease;
      }
      .tier:first-of-type { border-top: 1px solid var(--border); }
      .tier:hover { background: var(--surface); }
      .tier-n { color: var(--accent); font-weight: 500; padding-top: 0.2rem; }
      .tier-name { font-size: 1.3rem; font-weight: 700; letter-spacing: -0.02em; }
      .tier-tag {
        color: var(--muted);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-left: 1rem;
      }
      .tier-desc { display: block; color: var(--muted); max-width: 62ch; margin-top: 0.5rem; }
      .tier-cta { color: var(--accent); font-size: 1.3rem; justify-self: end; padding-top: 0.2rem; }

      /* ---- providers ---- */
      .providers { padding-block: 3.5rem 5rem; border-top: 1px solid var(--border); }
      .providers-label {
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.72rem;
        margin-bottom: 1.25rem;
      }
      .providers ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.6rem 1.75rem; }
      .providers li { font-size: 0.85rem; font-weight: 500; }
      .providers li::before { content: '·'; color: var(--accent); margin-right: 0.5rem; }

      /* ---- footer ---- */
      .footer {
        margin-top: auto;
        padding-block: 3.5rem 4rem;
        border-top: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1.5rem;
      }
      .reticle-sm { width: 1.6rem; height: 1.6rem; color: var(--accent); vertical-align: middle; }
      .foot-n { display: block; height: 28px; width: auto; opacity: 0.9; }
      .footer a:hover .foot-n { opacity: 1; }
      .foot-line { color: var(--muted); font-size: 0.82rem; max-width: 48ch; }

      /* ---- bubbles + socials ---- */
      .bubble {
        display: inline-block;
        padding: 0.28rem 0.85rem;
        border: 1px solid var(--border);
        border-radius: 9999px;
        font-size: 0.75rem;
        color: var(--text);
        text-decoration: none;
      }
      .bubble:hover { border-color: var(--accent); color: var(--accent); }
      .socials { display: flex; gap: 0.45rem; }
      .circ {
        width: 30px;
        height: 30px;
        border: 1px solid var(--border);
        border-radius: 9999px;
        display: grid;
        place-items: center;
        color: var(--muted);
        text-decoration: none;
        font-size: 0.78rem;
      }
      a.circ:hover { color: var(--accent); border-color: var(--accent); }
      .circ svg { width: 12px; height: 12px; }

      /* ---- motion ---- */
      .reveal { opacity: 0; transform: translateY(12px); animation: rise 380ms cubic-bezier(0.16, 1, 0.3, 1) forwards; }
      .reveal:nth-child(2) { animation-delay: 60ms; }
      .reveal:nth-child(3) { animation-delay: 120ms; }
      .reveal:nth-child(4) { animation-delay: 180ms; }
      .reveal:nth-child(5) { animation-delay: 240ms; }
      @keyframes rise { to { opacity: 1; transform: none; } }
      @media (prefers-reduced-motion: reduce) {
        .reveal { animation: none; opacity: 1; transform: none; }
        html { scroll-behavior: auto; }
      }

      /* ---- responsive ---- */
      @media (max-width: 56rem) {
        .why { grid-template-columns: 1fr; }
        .escape-grid { grid-template-columns: 1fr; }
        .tier { grid-template-columns: 2.5rem minmax(0, 1fr); }
        .tier-cta { display: none; }
        .hooks td:nth-child(2), .hooks th:nth-child(2) { display: none; }
      }
      /* wordmark rises to sit left of the nav stack, above the socials row —
         must come after the base rules or the cascade overrides it */
      @media (max-width: 640px) {
        .hero { padding-top: 5.5rem; }
        .wordmark { font-size: clamp(2rem, 10.5vw, 2.75rem); position: relative; top: 20px; }
        .tagline { margin-top: 6rem; }
      }
    </style>
    <script is:inline>
      document.querySelector('.theme-toggle').addEventListener('click', () => {
        const light = document.documentElement.classList.toggle('light');
        try { localStorage.setItem('th-theme', light ? 'light' : 'dark'); } catch {}
      });
    </script>
  </body>
</html>
